{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "lib": [
            "ES2022",
            "DOM"
        ],
        "module": "Node16",
        "moduleResolution": "Node16",
        "maxNodeModuleJsDepth": 0,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022",
        "types": [
            "node",
            "vscode"
        ]
    },
    "include": [
        "src/**/*.js"
    ]
}
