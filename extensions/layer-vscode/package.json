{
    "name": "layer-engine-vscode",
    "displayName": "Layer-Engine",
    "description": "HTML and CSS IntelliSense, highlighting, snippets, diagnostics, and compiled preview for *.layer.js components.",
    "version": "0.2.0",
    "publisher": "solcorp",
    "license": "Apache-2.0",
    "private": true,
    "type": "commonjs",
    "engines": {
        "vscode": ">=1.95.0"
    },
    "categories": [
        "Programming Languages",
        "Linters",
        "Snippets"
    ],
    "activationEvents": [
        "onLanguage:javascript",
        "onCommand:layer.validateFile",
        "onCommand:layer.showCompiledOutput"
    ],
    "main": "./dist/extension.cjs",
    "repository": {
        "type": "git",
        "url": "https://github.com/soluser010/layer-engine.git",
        "directory": "extensions/layer-vscode"
    },
    "contributes": {
        "commands": [
            {
                "command": "layer.validateFile",
                "title": "Layer: Validate current component"
            },
            {
                "command": "layer.showCompiledOutput",
                "title": "Layer: Show compiled output"
            }
        ],
        "configuration": {
            "title": "Layer-Engine",
            "properties": {
                "layer.diagnostics.onSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Compile *.layer.js through the project's local Layer compiler when the file is saved."
                }
            }
        },
        "languages": [
            {
                "id": "javascript",
                "extensions": [
                    ".layer.js"
                ],
                "icon": {
                    "light": "./icons/layer-file-light.svg",
                    "dark": "./icons/layer-file-dark.svg"
                }
            }
        ],
        "grammars": [
            {
                "scopeName": "layer.injection.tagged-templates",
                "path": "./syntaxes/layer-injection.tmLanguage.json",
                "injectTo": [
                    "source.js"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.html.layer": "html",
                    "meta.embedded.block.css.layer": "css",
                    "meta.embedded.expression.js.layer": "javascript"
                }
            }
        ],
        "snippets": [
            {
                "language": "javascript",
                "path": "./snippets/layer.code-snippets.json"
            }
        ]
    },
    "scripts": {
        "build": "node ./scripts/build-extension.cjs",
        "package": "npm run build && vsce package --no-dependencies --out ../../artifacts/layer-engine-vscode-0.2.0.vsix",
        "test": "node --test ./test/*.test.cjs",
        "typecheck": "tsc -p jsconfig.json"
    },
    "dependencies": {
        "vscode-css-languageservice": "6.3.10",
        "vscode-html-languageservice": "5.6.2",
        "vscode-languageserver-textdocument": "1.0.14"
    },
    "devDependencies": {
        "@types/vscode": "1.95.0",
        "@vscode/vsce": "4.0.0",
        "esbuild": "0.28.2"
    }
}
